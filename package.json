{
  "name": "@curlewlabs-com/sqlite-store-gen",
  "version": "0.3.0",
  "description": "Generate a typed SQLite storage layer in Kotlin and Swift, and the Dart channel constants beside it, from one declarative spec.",
  "license": "MIT OR Apache-2.0",
  "author": "Curlew Labs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curlewlabs-com/sqlite-store-gen.git"
  },
  "private": true,
  "type": "module",
  "bin": {
    "sqlite-store-gen": "./src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/test-support.ts",
    "!src/test-timeout.ts",
    "README.md",
    "LICENSE-MIT",
    "LICENSE-APACHE"
  ],
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "bun test --no-install --timeout $(bun --no-install src/test-timeout.ts) src"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
