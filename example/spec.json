    {
      "toVersion": 2,
      "doc": "Seeds the settings row on stores created before the baseline seeded it.",
      "statements": [
        "INSERT OR IGNORE INTO app_settings (singleton_id, theme, tour_shown, last_highlight_key_ms, row_version) VALUES (1, 'system', 0, 0, 1)"
      ]
    },
    {
      "toVersion": 3,
      "doc": "Adds the reading speed preference to the settings row.",
      "statements": [
        "ALTER TABLE app_settings ADD COLUMN words_per_minute INTEGER NOT NULL DEFAULT 250"
      ]
    },
    {
      "toVersion": 4,
      "doc": "Adds the highlight queue and the index its per-reader cleanup reads.",
      "statements": [
        "CREATE TABLE IF NOT EXISTS pending_highlight (\n    staged_at_ms INTEGER PRIMARY KEY,\n    reader_id TEXT NOT NULL,\n    book_isbn TEXT NOT NULL,\n    excerpt TEXT NOT NULL,\n    margin_note TEXT,\n    page_number INTEGER,\n    captured_at_ms INTEGER NOT NULL,\n    upload_attempts INTEGER NOT NULL,\n    retry_not_before_ms INTEGER NOT NULL,\n    row_version INTEGER NOT NULL CHECK (row_version >= 1)\n) STRICT",
        "CREATE INDEX idx_pending_highlight_reader_captured ON pending_highlight (reader_id, captured_at_ms)"
      ]
    }
  ],
